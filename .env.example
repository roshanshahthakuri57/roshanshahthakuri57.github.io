# Copy to .env if you want to change the defaults. No secrets are needed.
# 127.0.0.1 = reachable only from this machine (put a TLS reverse proxy such as Caddy in front).
# Use 0.0.0.0 only if nothing else sits in front.
BIND=127.0.0.1
PORT=8080
# Give each site on the same host its own name so networks are never shared.
COMPOSE_PROJECT_NAME=portfolio
